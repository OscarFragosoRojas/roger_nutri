---
// src/components/ui/Card.astro
interface Props {
  class?: string;
  hover?: boolean;
}

const { class: className, hover = true } = Astro.props;
const hoverStyles = hover ? "hover:-translate-y-2 hover:shadow-2xl hover:shadow-emerald-500/10 hover:border-emerald-500/30" : "";
---

<div class={`bg-slate-900/50 backdrop-blur-xl rounded-3xl border border-slate-800/80 shadow-xl overflow-hidden transition-all duration-500 ${hoverStyles} ${className || ''}`}>
  <slot />
</div>
