---
// src/components/ui/Button.astro
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'glass';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;

const baseStyles = "inline-flex items-center justify-center px-8 py-4 text-base font-semibold rounded-xl transition-all duration-300 focus:outline-none tracking-wide";
const variants = {
  primary: "bg-gradient-to-r from-emerald-500 to-teal-600 text-white hover:from-emerald-400 hover:to-teal-500 shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40 hover:-translate-y-1",
  secondary: "bg-slate-800 text-white hover:bg-slate-700 shadow-md hover:shadow-xl hover:-translate-y-1",
  outline: "border-2 border-emerald-500/50 text-emerald-400 hover:bg-emerald-500/10 hover:border-emerald-400",
  glass: "bg-white/5 backdrop-blur-md border border-white/10 text-white hover:bg-white/10 hover:border-white/20 shadow-xl",
};

const Tag = href ? 'a' : 'button';
---

<Tag href={href} class={`${baseStyles} ${variants[variant]} ${className || ''}`}>
  <slot />
</Tag>
