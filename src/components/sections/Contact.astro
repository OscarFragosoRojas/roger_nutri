---
// src/components/sections/Contact.astro
import Button from '../ui/Button.astro';
---

<section id="contacto" class="py-24 bg-slate-900 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-4xl md:text-5xl font-black text-white mb-6">¿Listo para tu transformación?</h2>
      <p class="text-xl text-slate-400 font-light">Agenda tu evaluación clínica y comencemos a diseñar tu programa de nutrición y entrenamiento.</p>
    </div>

    <div class="max-w-2xl mx-auto bg-slate-950/50 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl p-8 md:p-12">
      <form class="space-y-6">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-400 mb-2 uppercase tracking-wider">Nombre Completo</label>
          <input type="text" id="name" name="name" required class="w-full bg-slate-900 border border-white/10 text-white px-5 py-4 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors outline-none" placeholder="Ingresa tu nombre">
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="phone" class="block text-sm font-medium text-slate-400 mb-2 uppercase tracking-wider">WhatsApp</label>
            <input type="tel" id="phone" name="phone" required class="w-full bg-slate-900 border border-white/10 text-white px-5 py-4 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors outline-none" placeholder="+52 55 1234 5678">
          </div>
          <div>
            <label for="goal" class="block text-sm font-medium text-slate-400 mb-2 uppercase tracking-wider">Objetivo Principal</label>
            <select id="goal" name="goal" class="w-full bg-slate-900 border border-white/10 text-white px-5 py-4 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors outline-none appearance-none">
              <option value="clinico">Salud Clínica / Patología</option>
              <option value="estetico">Pérdida de Grasa</option>
              <option value="musculo">Aumento de Masa Muscular</option>
              <option value="rendimiento">Rendimiento Deportivo</option>
            </select>
          </div>
        </div>

        <div>
          <label for="message" class="block text-sm font-medium text-slate-400 mb-2 uppercase tracking-wider">Cuéntanos sobre tu caso</label>
          <textarea id="message" name="message" rows="4" class="w-full bg-slate-900 border border-white/10 text-white px-5 py-4 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition-colors outline-none resize-none" placeholder="Describe brevemente tus hábitos actuales y objetivos..."></textarea>
        </div>

        <Button variant="primary" class="w-full py-5 text-lg mt-4">
          Solicitar Evaluación
        </Button>
      </form>
    </div>
  </div>
</section>
