---
// src/components/sections/Footer.astro
---

<footer class="bg-slate-950 border-t border-white/5 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <a
          href="#"
          class="text-3xl font-black text-white tracking-tighter flex items-center gap-2 mb-6"
        >
          <span
            class="bg-linear-to-br from-emerald-400 to-teal-600 bg-clip-text text-transparent"
            >Dr. Roger</span
          >
        </a>
        <p class="text-slate-400 font-light max-w-sm leading-relaxed">
          Ciencia, Nutrición Clínica y Entrenamiento Físico integrados para
          llevar tu cuerpo a su mejor versión.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-widest mb-6">
          Navegación
        </h3>
        <ul class="space-y-4">
          <li>
            <a
              href="#enfoque"
              class="text-slate-400 hover:text-emerald-400 transition-colors font-medium"
              >El Método</a>
          </li>
          <li>
            <a
              href="#sobre-mi"
              class="text-slate-400 hover:text-emerald-400 transition-colors font-medium"
              >Conoce al Dr. Roger</a>
          </li>
          <li>
            <a
              href="#testimonios"
              class="text-slate-400 hover:text-emerald-400 transition-colors font-medium"
              >Casos de Éxito</a>
          </li>
          <li>
            <a
              href="#contacto"
              class="text-slate-400 hover:text-emerald-400 transition-colors font-medium"
              >Agenda tu Cita</a>
          </li>
        </ul>
      </div>

      <!-- Contact Info -->
      <div>
        <h3 class="text-sm font-bold text-white uppercase tracking-widest mb-6">
          Contacto Directo
        </h3>
        <ul class="space-y-4">
          <li class="flex items-start">
            <svg
              class="w-6 h-6 text-emerald-500 mr-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
              ></path><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg
            >
            <span class="text-slate-400"
              >Torre Médica Élite, Cons. 402<br />Ciudad de México, CP 01000</span
            >
          </li>
          <li class="flex items-center">
            <svg
              class="w-6 h-6 text-emerald-500 mr-4 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.5"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              ></path></svg
            >
            <span class="text-slate-400">+52 55 1234 5678</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-white/5 pt-8 flex flex-col md:flex-row justify-between items-center text-sm"
    >
      <p class="text-slate-500">
        &copy; {new Date().getFullYear()} Dr. Roger Nutrición & Fitness. Todos los
        derechos reservados.
      </p>
    </div>
  </div>
</footer>
