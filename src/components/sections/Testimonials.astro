---
// src/components/sections/Testimonials.astro
import Card from "../ui/Card.astro";

const testimonials = [
  {
    text: "Mi objetivo era bajar de peso, pero mi salud metabólica estaba mal. El Dr. Roger no solo mejoró mis laboratorios clínicos, sino que mi físico cambió drásticamente gracias a sus rutinas.",
    author: "Alejandro M.",
    tag: "Pérdida de Peso & Salud",
  },
  {
    text: "Como atleta, necesitaba mejorar mi rendimiento sin comprometer mi salud. El enfoque dual entre la clínica y la preparación física fue exactamente lo que me llevó al siguiente nivel.",
    author: "Sofía T.",
    tag: "Rendimiento Deportivo",
  },
  {
    text: "Toda la vida batallé con dietas extremas. Aprender a nutrirme científicamente y entrenar con propósito cambió mi cuerpo y mi relación con la comida. 100% recomendado.",
    author: "David R.",
    tag: "Recomposición Corporal",
  },
];
---

<section
  id="testimonios"
  class="py-24 bg-slate-950 relative border-t border-white/5"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-20">
      <h2
        class="text-sm font-bold text-teal-500 uppercase tracking-widest mb-3"
      >
        Casos de Éxito
      </h2>
      <h3 class="text-4xl md:text-5xl font-black text-white mb-6">
        Transformaciones Reales
      </h3>
      <p class="text-xl text-slate-400 font-light">
        No prometemos milagros, ofrecemos ciencia, disciplina y resultados
        demostrables. Esto dicen quienes ya cambiaron su vida.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((testi) => (
          <Card class="p-8 flex flex-col h-full bg-slate-900/40">
            <div class="flex text-emerald-400 mb-6">
              {[1, 2, 3, 4, 5].map(() => (
                <svg
                  class="w-5 h-5 drop-shadow-[0_0_8px_rgba(52,211,153,0.5)]"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <p class="text-slate-300 font-light leading-relaxed mb-8 grow">
              "{testi.text}"
            </p>
            <div class="border-t border-white/10 pt-4 mt-auto">
              <p class="font-bold text-white tracking-wide">{testi.author}</p>
              <p class="text-sm font-medium text-emerald-500">{testi.tag}</p>
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
